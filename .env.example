# Copy to .env and edit. Restart `npx expo start` after changing.

# Base URL of the Flockwise REST API (the Hostinger backend), including the version prefix.
EXPO_PUBLIC_API_URL=https://api.flockwise.church/v1

# true = use built-in demo data (no backend needed). Set to false once the API is live.
EXPO_PUBLIC_USE_MOCKS=true

# development | preview | production
APP_ENV=development
