{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_USE_MOCKS": "true",
        "EXPO_PUBLIC_API_URL": "https://staging-api.flockwise.church/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_USE_MOCKS": "true",
        "EXPO_PUBLIC_API_URL": "https://staging-api.flockwise.church/v1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_USE_MOCKS": "false",
        "EXPO_PUBLIC_API_URL": "https://api.flockwise.church/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
